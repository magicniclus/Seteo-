# Copie ce fichier en ".env" et remplis-le. Ne le partage JAMAIS (il contient tes clés).

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Meta (Instagram) : voir README étape 4
INSTAGRAM_ACCOUNT_ID=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=invente-un-mot-de-passe-long
META_GRAPH_VERSION=v23.0

# YouTube (veille des Shorts) : https://console.cloud.google.com -> API YouTube Data v3 -> Identifiants
YOUTUBE_API_KEY=

# --- Montage (toutes facultatives) ---
# Transcription la plus précise en français : https://elevenlabs.io -> API Keys (sinon : Whisper en local)
ELEVENLABS_API_KEY=
# Plans de coupe libres de droits : https://www.pexels.com/api/ (gratuit)
PEXELS_API_KEY=
# Les « yeux » : Gemini regarde la vidéo montée et dit quoi corriger : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mot de passe pour /studio, /stats et le prompteur (?cle=...)
STATS_KEY=invente-un-autre-mot-de-passe

# Adresse qui reçoit chaque nouvel inscrit (ton site Portail Travaux, Brevo, Zapier, Make...)
PORTAIL_TRAVAUX_WEBHOOK_URL=
